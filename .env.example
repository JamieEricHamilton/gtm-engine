# gtm-engine - every variable, placeholder or secret the stack needs. Nothing here is a real value.

# ---- n8n host (infra/docker-compose.yml, written to /opt/n8n/.env by infra/cloud-init.yaml) ----
N8N_HOST=n8n.example.com            # editor hostname (Caddy terminates TLS)
WEBHOOK_HOST=hooks.example.com      # public hostname that only serves webhook/form/OAuth paths
DB_PASSWORD=                        # Postgres password for n8n's own database (generated once by cloud-init)
N8N_ENCRYPTION_KEY=                 # encrypts every credential in n8n; lose it and every credential is unreadable
CH_STREAM_KEY=                      # Companies House Streaming API key, used only by the ch-stream listener container
CH_WEBHOOK_PATH=                    # random path of the register-stream intake webhook (workflows/account-intelligence/d14-register-stream-intake.json)

# ---- credentials created inside n8n (names as the workflow JSON references them) ----
# CRED_SUPABASE            Supabase service role key for the signals database (never the anon key)
# CRED_ANTHROPIC           Anthropic API key (pre-revenue / own work)
# CRED_ANTHROPIC_CLIENT    Anthropic API key on the client-facing organisation (paying-client data only)
# CRED_GMAIL               Gmail OAuth2 (Google Cloud project with an Internal app so refresh tokens do not expire)
# CRED_GSHEETS             Google Sheets OAuth2
# CRED_COMPANIES_HOUSE     Companies House REST API key, basic auth, key as username, empty password
# CRED_REED                Reed Jobseeker API key, basic auth, key as username
# CRED_APIFY               Apify token, header auth "Authorization: Bearer <token>"
# CRED_ZOHO_RECRUIT        Zoho Recruit OAuth2 (generic OAuth2 credential; data-centre-specific auth and token URLs)
# CRED_TELEGRAM_ALERTS     Telegram bot token for the alerts bot
# CRED_WATCHDOG            Bearer token for the self-healing routine's HTTP trigger

# ---- placeholders inside the workflow JSON (search and replace before importing) ----
YOUR_SUPABASE_PROJECT_REF=          # https://<ref>.supabase.co
SHEET_ID_RAW_ACCOUNT_LIST=          # one-off ingest source (account name, LinkedIn URL, website)
SHEET_ID_SDR_CALL_LIST=             # the sheet the SDR works from; also carries the "Contact requests" tab
SHEET_ID_DEMO_JOBS=                 # recruitment demo: job specs
SHEET_ID_SCREENING_LOG=             # recruitment demo: screening log
SHEET_ID_OUTREACH_QUEUE=            # hunter: LinkedIn outreach queue
TELEGRAM_CHAT_ID=                   # chat id the alerts bot posts to (stored in account_intel.settings)
ROUTINE_ID=                         # id of the self-healing agent routine fired by the error workflow
N8N_PROJECT_ID=                     # n8n project the workflows live in
REPLACE_WITH_RANDOM_PATH=           # webhook path for the register stream intake (openssl rand -hex 16)

# ---- tooling ----
N8N_API_KEY=                        # n8n public API key, used to export workflows (tools/export_workflows.sh)
CLOUDFLARE_ACCOUNT_ID=              # site/: Cloudflare Pages deploy
CLOUDFLARE_API_TOKEN=               # site/: token with Pages Edit

# ---- GitHub Actions secrets for .github/workflows/results.yml ----
SUPABASE_URL=                       # https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=          # read side only runs one aggregate function; a dedicated read-only role is the better long-term option
# Repository variable RESULTS_RPC    name of the aggregate function (intel_results in this repo)
