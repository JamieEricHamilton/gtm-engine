    {
      "id": "b6b2041e-7fb5-4c30-9632-44f8d0545dc5",
      "name": "Zoho: associate with job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        672,
        -96
      ],
      "parameters": {
        "method": "PUT",
        "url": "https://recruit.zoho.uk/recruit/v2/Candidates/actions/associate",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"data\": [\n    {\n      \"jobids\": [ String($('When Executed by Another Workflow').item.json.zoho_job_id) ],\n      \"ids\": [ String($('Zoho: upsert candidate').item.json.data[0].details.id) ],\n      \"comments\": \"Associated by OpsAutomated screening\"\n    }\n  ]\n} }}",
        "options": {}
      },
