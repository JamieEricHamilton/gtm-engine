    {
      "id": "e9508fe4-f506-4e24-898d-90e5e0e5ee81",
      "name": "Zoho: add note",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        896,
        -96
      ],
      "parameters": {
        "method": "POST",
        "url": "https://recruit.zoho.uk/recruit/v2/Notes",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => {\n  const c = $('When Executed by Another Workflow').item.json;\n  const id = String($('Zoho: upsert candidate').item.json.data[0].details.id);\n  const flags = String(c.flags ?? '').trim() || 'none';\n  const title = 'OpsAutomated screening: ' + c.job_ref + ' - ' + c.fit_score + '/10 (' + c.band + ')';\n  const content =\n    'Fit score ' + c.fit_score + '/10, band ' + c.band + '.\\n' +\n    'Rationale: ' + c.rationale + '\\n' +\n    'Flags: ' + flags + '\\n' +\n    'Salary expectation: ' + (c.salary_expectation || 'not stated') + '\\n' +\n    'Right to work: ' + (c.right_to_work || 'not stated') + '\\n' +\n    'Received: ' + c.received_at;\n  return {\n    \"data\": [\n      {\n        \"Note_Title\": title,\n        \"Note_Content\": content,\n        \"Parent_Id\": id,\n        \"se_module\": \"Candidates\"\n      }\n    ]\n  };\n})() }}",
        "options": {}
      },
      "credentials": {
        "oAuth2Api": {
          "id": "CRED_ZOHO_RECRUIT",
          "name": "Zoho Recruit OAuth2"
        }
      }
    },
    {
      "id": "ef781e73-b3b4-41d2-babb-0a4195c1e07b",
      "name": "Zoho: tag by band",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1120,
        -96
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ (() => {\n  const band = String($('When Executed by Another Workflow').item.json.band ?? '').trim().toUpperCase();\n  const tag = band === 'A' ? 'Band A' : band === 'B' ? 'Band B' : band === 'C' ? 'Band C' : 'Rejected';\n  const id = String($('Zoho: upsert candidate').item.json.data[0].details.id);\n  return 'https://recruit.zoho.uk/recruit/v2/Candidates/' + id + '/actions/add_tags?tag_names=' + encodeURIComponent(tag);\n})() }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "options": {}
      },
      "credentials": {
        "oAuth2Api": {
          "id": "CRED_ZOHO_RECRUIT",
          "name": "Zoho Recruit OAuth2"
        }
      }
