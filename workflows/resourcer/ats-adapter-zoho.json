    {
      "id": "fbde821a-5b8e-4735-ad7e-c7b654b176f9",
      "name": "Return to caller",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        -96
      ],
      "parameters": {
        "jsCode": "const input = $('When Executed by Another Workflow').first().json;\nconst candidateId = String($('Zoho: upsert candidate').first().json.data[0].details.id);\nconst action = $('Zoho: upsert candidate').first().json.action;\n\nreturn [{\n  json: {\n    ...input,\n    zoho_candidate_id: candidateId,\n    zoho_candidate_url: 'https://recruit.zoho.uk/recruit/org13002531943/EntityInfo.do?module=Candidates&id=' + candidateId + '&submodule=Candidates',\n    ats_action: action\n  }\n}];"
      }
    }
