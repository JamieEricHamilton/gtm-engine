    {
      "id": "6dd904d9-a7af-4edc-b72e-fa1c56a5c171",
      "name": "Zoho: upsert candidate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        224,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://recruit.zoho.uk/recruit/v2/Candidates/upsert",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => {\n  const name = String($json.full_name ?? '').trim();\n  const parts = name.split(/\\s+/);\n  const last = parts.length > 1 ? parts.slice(-1)[0] : (name || 'Unknown');\n  const first = parts.length > 1 ? parts.slice(0, -1).join(' ') : name;\n  const email = String($json.email ?? '').trim();\n  const city = String($json.location ?? '').split(',')[0].trim();\n  const rec = {\n    \"First_Name\": first,\n    \"Last_Name\": last,\n    \"Mobile\": String($json.phone ?? '').replace(/\\s+/g, ''),\n    \"City\": city,\n    \"Current_Job_Title\": String($json.current_title ?? ''),\n    \"Current_Employer\": String($json.current_employer ?? ''),\n    \"Experience_in_Years\": Number($json.years_experience) || 0,\n    \"Skill_Set\": String($json.key_skills ?? ''),\n    \"Source\": \"Job board\"\n  };\n  if (email.includes('@')) rec[\"Email\"] = email;\n  return { \"data\": [rec], \"duplicate_check_fields\": [\"Email\"] };\n})() }}",
        "options": {}
      },
      "credentials": {
        "oAuth2Api": {
          "id": "CRED_ZOHO_RECRUIT",
          "name": "Zoho Recruit OAuth2"
        }
      }
    },
    {
      "id": "cf801bb6-3c2b-4d54-a654-c9ccda1b1f95",
