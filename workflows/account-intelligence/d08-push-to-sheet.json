        "jsonBody": "{\"requests\":[{\"updateCells\":{\"range\":{\"sheetId\":0,\"startRowIndex\":0,\"endRowIndex\":1,\"startColumnIndex\":12,\"endColumnIndex\":14},\"rows\":[{\"values\":[{\"userEnteredValue\":{\"stringValue\":\"Sequence\"}},{\"userEnteredValue\":{\"stringValue\":\"Sequence date\"}}]}],\"fields\":\"userEnteredValue\"}},{\"setDataValidation\":{\"range\":{\"sheetId\":0,\"startRowIndex\":1,\"endRowIndex\":1000,\"startColumnIndex\":10,\"endColumnIndex\":11},\"rule\":{\"condition\":{\"type\":\"ONE_OF_LIST\",\"values\":[{\"userEnteredValue\":\"Worked\"},{\"userEnteredValue\":\"Meeting booked\"},{\"userEnteredValue\":\"Not a fit\"}]},\"strict\":true,\"showCustomUi\":true}}},{\"setDataValidation\":{\"range\":{\"sheetId\":0,\"startRowIndex\":1,\"endRowIndex\":1000,\"startColumnIndex\":12,\"endColumnIndex\":13},\"rule\":{\"condition\":{\"type\":\"ONE_OF_LIST\",\"values\":[{\"userEnteredValue\":\"In sequence\"},{\"userEnteredValue\":\"Finished sequence\"}]},\"strict\":true,\"showCustomUi\":true}}},{\"setDataValidation\":{\"range\":{\"sheetId\":0,\"startRowIndex\":1,\"endRowIndex\":1000,\"startColumnIndex\":13,\"endColumnIndex\":14},\"rule\":{\"condition\":{\"type\":\"DATE_IS_VALID\"},\"strict\":false,\"showCustomUi\":true}}}]}",
        "method": "POST",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "options": {
          "timeout": 60000
        },
        "sendBody": true,
        "specifyBody": "json",
        "url": "https://sheets.googleapis.com/v4/spreadsheets/SHEET_ID_SDR_CALL_LIST:batchUpdate"
      },
