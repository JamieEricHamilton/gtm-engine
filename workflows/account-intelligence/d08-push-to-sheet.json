    {
      "id": "46517a88-f4fe-4339-9bea-a6768ec37123",
      "name": "Rows to delete",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        320
      ],
      "parameters": {
        "jsCode": "// Pattern: never delete by position you have not just read. Read the sheet, map account_id -> row_number, delete bottom-up so earlier deletes do not shift later rows.\nlet removals = [];\ntry { removals = JSON.parse(String($('Removals (Supabase RPC)').first().json.body || '[]')); } catch (e) { removals = []; }\nconst ids = new Set(removals.map(r => String(r.account_id)));\nif (!ids.size) return [];\nconst rows = $input.all().map(i => i.json).filter(r => r && r.row_number && ids.has(String(r.account_id)));\nrows.sort((a, b) => Number(b.row_number) - Number(a.row_number));\nreturn rows.map(r => ({ json: { account_id: r.account_id, account: r.Account, row_number: Number(r.row_number), reason: (removals.find(x => String(x.account_id) === String(r.account_id)) || {}).reason || '' } }));",
        "mode": "runOnceForAllItems"
      }
    },
