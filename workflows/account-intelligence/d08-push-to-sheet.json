    {
      "id": "3a9e5369-9bbb-4d27-82fb-5326da7e170f",
      "name": "Build morning note",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        96
      ],
      "parameters": {
        "jsCode": "let rows = [];\ntry { rows = JSON.parse(String($input.first().json.body || '[]')); } catch (e) { rows = []; }\nlet apify = '';\ntry { let v = String($('Apify usage (Supabase RPC)').first().json.body || ''); v = JSON.parse(v); if (typeof v === 'string') v = JSON.parse(v); if (v && v.used_usd != null) apify = 'Apify: $' + Number(v.used_usd).toFixed(2) + ' of $' + v.limit_usd + ' this cycle'; } catch (e) { apify = ''; }\nconst a = rows.filter(r => r.band === 'A'), b = rows.filter(r => r.band === 'B');\nconst line = r => '• ' + r.account + ' (' + r.lead_product + '): ' + r.trigger_line;\nlet body = 'Morning. ' + (rows.length ? rows.length + ' new account' + (rows.length > 1 ? 's' : '') + ' on the call list overnight.' : 'Nothing new on the call list overnight.') + '\\n';\nif (a.length) body += '\\nA band\\n' + a.map(line).join('\\n') + '\\n';\nif (b.length) body += '\\nB band\\n' + b.map(line).join('\\n') + '\\n';\nif (apify) body += '\\n' + apify;\nif (body.length > 3900) body = body.slice(0, 3850) + '\\n…more on the sheet';\nreturn [{ json: { body } }];",
        "mode": "runOnceForAllItems"
      }
    },
