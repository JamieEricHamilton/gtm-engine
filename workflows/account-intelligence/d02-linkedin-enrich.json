          "name": "Supabase (service role)"
        }
      },
      "executeOnce": true
    },
    {
      "id": "dd52b64e-9a23-4526-929e-34743bab59fa",
      "name": "Build Apify batches",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// One item per Apify call. URL where we have one, name search where we don't.\nconst size = Number($('Config').first().json.batch_size) || 25;\nconst rows = $input.all().map(i => i.json);\nconst out = [];\nfor (let i = 0; i < rows.length; i += size) {\n  const chunk = rows.slice(i, i + size);\n  out.push({ json: {\n    batch_id: new Date().toISOString().slice(0,16) + '-' + (out.length + 1),\n    companies: chunk.filter(r => r.linkedin_url).map(r => r.linkedin_url),\n    searches: chunk.filter(r => !r.linkedin_url).map(r => r.name),\n    account_ids: chunk.map(r => r.account_id)\n  } });\n}\nreturn out;"
      }
    },
    {
      "id": "85d67fb6-ea76-4f20-8d3a-2013c04a1919",
      "name": "Apify LinkedIn company",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        896,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/harvestapi~linkedin-company/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ companies: $json.companies, searches: $json.searches }) }}",
        "options": {
          "timeout": 300000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1000
            }
          },
          "response": {
            "response": {
              "outputPropertyName": "body",
              "responseFormat": "text"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CRED_APIFY",
          "name": "Apify (header auth)"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "ff4cfcf2-343f-4cf6-8438-dfeaf9d20fac",
      "name": "Collect items per batch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// One item per Apify call: parse the JSON array, drop bulky fields, keep batch_id from the matching input item.\n// Posts are kept as text + date only: they are the best news source for SMBs (new office, new hires abroad).\nconst b = $('Build Apify batches').item.json;\nlet rows = [];\ntry { const parsed = JSON.parse(String($json.body || '[]')); rows = Array.isArray(parsed) ? parsed : (parsed.items || []); } catch (e) { rows = []; }\nconst DROP = ['similarOrganizations', 'affiliatedPages', 'logos', 'backgroundCovers', 'backgroundCover', 'logo', 'employees'];\nconst slim = rows.map(r => {\n  const o = { ...r }; for (const k of DROP) delete o[k];\n  if (Array.isArray(o.posts)) o.posts = o.posts.slice(0, 10).map(p => ({ text: String(p.text || p.content || '').slice(0, 600), date: p.postedAt || p.date || p.createdAt || null, url: p.url || p.linkedinUrl || null }));\n  return o;\n});\nreturn { json: { batch_id: b.batch_id, items: slim, count: slim.length, sent: (b.companies || []).length + (b.searches || []).length } };"
      }
    },
    {
      "id": "3075bc81-723d-4812-b51f-a80be0cb48bb",
