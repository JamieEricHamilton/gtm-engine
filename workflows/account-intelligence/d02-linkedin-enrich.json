{
  "id": "WF_D02_LINKEDIN_ENRICH",
  "name": "AI D2 - LinkedIn enrich",
  "description": "Apify harvestapi/linkedin-company on account_intel.accounts: headcount, HQ, industry, funding. Raw rows landed, then mapped and disqualifiers applied.",
  "nodes": [
    {
      "id": "4ee004d6-1936-463a-bbb9-0efb18f37000",
