      "typeVersion": 1,
      "position": [
        0,
        320
      ],
      "parameters": {
        "content": "## D2 - LinkedIn enrich (Apify harvestapi/linkedin-company)\nLoads non-dissolved accounts without headcount → batches of 25 → Apify run-sync → raw rows landed in account_intel.linkedin_raw → (next node) mapped onto account_intel.accounts and disqualifiers applied.\n\nPaid step: ~$4 per 1,000 companies. account_limit in Config caps spend per run.",
        "color": 4,
        "width": 520,
        "height": 180
      }
    },
    {
      "id": "ecb6b54b-d317-4184-a684-1351f9d9fa44",
      "name": "Run enrich (manual)",
      "type": "n8n-nodes-base.manualTrigger",
