      "name": "Load accounts for jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        448,
        96
      ],
      "parameters": {
        "method": "POST",
        "url": "https://YOUR_SUPABASE_PROJECT_REF.supabase.co/rest/v1/rpc/intel_accounts_for_jobs",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_limit: $json.account_limit }) }}",
        "options": {}
      },
      "credentials": {
        "supabaseApi": {
          "id": "CRED_SUPABASE",
          "name": "Supabase (service role)"
        }
      },
      "executeOnce": true
    },
    {
      "id": "66bc7bd7-dbb1-4f2b-bd65-aa0cac056bf7",
      "name": "Batches of 10",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// One company per call. Tested 12 Oct: a batch can return nothing for every company in it when one slug fails to resolve, and the actor charges per result, so singles cost nothing extra.\nconst c = $('Config').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r.linkedin_url && /linkedin\\.com\\/company\\/[^/]{3,}/.test(r.linkedin_url));\nreturn rows.map((r, i) => ({ json: { batch_id: new Date().toISOString().slice(0,16) + '-' + (i + 1), account_id: r.account_id, company: [r.linkedin_url.replace(/\\/(about|jobs|posts)\\/?$/, '')], postedLimit: c.posted_limit, maxItems: Number(c.max_items) || 100 } }));"
      }
    },
    {
      "id": "8794e447-eb50-4acb-94b6-e7c4c8b8294c",
      "name": "Apify LinkedIn jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        896,
        96
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/harvestapi~linkedin-job-search/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ company: $json.company, postedLimit: $json.postedLimit, maxItems: $json.maxItems, sortBy: \"date\" }) }}",
        "options": {
          "timeout": 300000,
          "batching": {
            "batch": {
              "batchSize": 4,
              "batchInterval": 500
            }
          },
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "body"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CRED_APIFY",
          "name": "Apify (header auth)"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "7311ba90-7949-458c-8342-45eb43ba3a11",
      "name": "Parse response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        96
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $('Batches of 10').item.json;\nlet rows = []; let err = null;\nif ($json.error) { err = typeof $json.error === 'string' ? $json.error : JSON.stringify($json.error).slice(0, 500); }\nelse {\n  try { const p = JSON.parse(String($json.body || '[]')); rows = Array.isArray(p) ? p : (p.items || []); if (!Array.isArray(p) && !p.items) err = String($json.body).slice(0, 500); } catch (e) { err = 'unparseable: ' + String($json.body).slice(0, 300); }\n}\nconst slim = rows.map(r => { const o = { ...r }; delete o.descriptionHtml; if (o.descriptionText) o.descriptionText = String(o.descriptionText).slice(0, 4000); if (b.account_id) o.account_id = b.account_id; return o; });\nreturn { json: { batch_id: b.batch_id, items: slim, count: slim.length, sent: (b.company || []).length, error: err, companies: b.company } };"
      }
    },
    {
      "id": "28f5a9d1-802f-48d5-9c43-fc2fd644aa7e",
      "name": "Save jobs raw (Supabase RPC)",
      "type": "n8n-nodes-base.httpRequest",
