      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Rows the CRM-side agent has written (Company present) that D15 has not touched yet (Status empty).\nconst rows = $input.all().map(i => i.json).filter(r => r && r.row_number && String(r.Company || '').trim() && !String(r.Status || '').trim());\nif (!rows.length) return [];\nreturn [{ json: { rows: rows.map(r => ({ sheet_row: Number(r.row_number), company: String(r.Company).trim(), domain: String(r.Domain || '').trim(), page: String(r['Page visited'] || '').trim(), country: String(r['Country of interest'] || '').trim() })) } }];"
      }
