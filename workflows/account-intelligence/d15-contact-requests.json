    {
      "id": "55c083cf-350b-41fb-8d4b-747e412ad763",
      "name": "Build row values",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2464,
        96
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Works for both inputs: a claimed row with no scrape (no_match / no_linkedin) and the save result (found / none_found / error).\nconst j = $json;\nconst labels = { found: 'Found', none_found: 'No senior profiles found', no_linkedin: 'No LinkedIn page on file', no_match: 'Not in the book - check the domain', error: 'Scrape failed, will retry' };\nconst contacts = Array.isArray(j.contacts) ? j.contacts : [];\nconst cells = [labels[j.status] || j.status, j.headcount || '', j.open_roles || ''];\nfor (let i = 0; i < 4; i++) { const c = contacts[i]; cells.push(c ? c.name : ''); cells.push(c ? (c.title || '') : ''); cells.push(c ? c.url : ''); }\ncells.push(new Date().toISOString().slice(0, 16).replace('T', ' '));\nreturn { json: { range: 'Contact requests!E' + j.sheet_row + ':T' + j.sheet_row, values: [cells] } };"
      }
    },
