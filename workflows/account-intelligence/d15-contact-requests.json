    {
      "id": "cf71f227-587d-4328-8cc3-1c7c06ce3d40",
      "name": "Rank contacts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2016,
        32
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Pick up to 4 buyers by headcount band. Rank 1 = first choice, 2 = second choice, 3 = other senior titles (Chief of Staff etc).\nconst req = $('Claim requests (Supabase RPC)').item.json;\nlet rows = [], err = null;\nif ($json.error) err = typeof $json.error === 'string' ? $json.error : JSON.stringify($json.error).slice(0, 500);\nelse { try { const p = JSON.parse(String($json.body || '[]')); rows = Array.isArray(p) ? p : (p.items || []); if (!Array.isArray(p) && !p.items) err = String($json.body).slice(0, 500); } catch (e) { err = 'unparseable: ' + String($json.body).slice(0, 300); } }\nconst hc = Number(req.headcount) || 0;\nconst founder = /founder|\\bceo\\b|chief executive|managing director|\\bmd\\b|\\bowner\\b/i;\nconst bands = {\n  small: [[founder], [/\\bcoo\\b|chief operating|head of operations|operations director|director of operations/i]],\n  mid: [[/head of people|people ops|people operations|\\bhr manager\\b|hr business partner|head of hr|chief people|people director|hr director/i], [/\\bcoo\\b|chief operating|head of operations|operations director|finance director|\\bcfo\\b|chief financial|head of finance/i, founder]],\n  large: [[/hr director|head of people|chief people|vp people|people director|director of people|head of hr|chief human/i], [/talent acquisition|head of talent|finance director|\\bcfo\\b|head of finance|payroll/i]]\n};\n// Loosely attached people LinkedIn returns under a company filter: never real buyers.\nconst junk = /freelanc|self.?employed|independent|^consultant$|^associate$|^contractor$|advis[eo]r$|^student|intern\\b|^retired/i;\nconst band = hc && hc < 50 ? 'small' : (hc && hc <= 200 ? 'mid' : (hc ? 'large' : 'small'));\nconst slug = String(req.linkedin_url || '').replace(/\\/$/, '').split('/').pop().toLowerCase();\nconst titleOf = p => {\n  const cur = (p.experience || []).find(e => e && e.endDate && /present/i.test(String(e.endDate.text || '')) && (!slug || String(e.companyUniversalName || '').toLowerCase() === slug || String(e.companyLinkedinUrl || '').toLowerCase().includes('/company/' + slug)));\n  if (cur && cur.position) return String(cur.position).trim();\n  const anyCur = (p.experience || []).find(e => e && e.endDate && /present/i.test(String(e.endDate.text || '')));\n  if (anyCur && anyCur.position) return String(anyCur.position).trim();\n  return String(p.headline || '').split(/\\s[|@]\\s| at /)[0].trim();\n};\nconst scored = rows.filter(p => p && p.linkedinUrl).map(p => {\n  const title = titleOf(p);\n  const [first, second] = bands[band];\n  let r = first.some(x => x.test(title)) ? 1 : (second.some(x => x.test(title)) ? 2 : 3);\n  if (r === 3 && junk.test(title)) r = 9;\n  return { full_name: [p.firstName, p.lastName].filter(Boolean).join(' ').trim(), title, headline: String(p.headline || '').slice(0, 300), linkedin_url: p.linkedinUrl, location: (p.location && (p.location.linkedinText || p.location.text)) || '', rank: String(r) };\n}).filter(c => c.rank !== '9').sort((a, b) => Number(a.rank) - Number(b.rank));\nreturn { json: { request_id: req.request_id, items: scored.slice(0, 4), found: rows.length, error: err } };"
      }
    },
